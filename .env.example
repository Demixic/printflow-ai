# Copy to .env (or .env.local) and fill in. Never commit the real file.
# Both files are gitignored; only this example is tracked.

# PostgreSQL connection string, read only on the server (Prisma runtime + CLI).
# Do NOT prefix with NEXT_PUBLIC_ — that would expose it to the browser bundle.
# Local docker-compose default:
DATABASE_URL="postgresql://printflow:printflow@localhost:5432/printflow?schema=public"

# Optional direct (non-pooled) connection used only by Prisma CLI commands
# such as `prisma migrate deploy`. Set it when DATABASE_URL goes through a pooler
# (e.g. Neon on Vercel provides this variable automatically). Leave unset locally.
# DATABASE_URL_UNPOOLED=""

# IANA time zone the shop works in. Decides what "today", "overdue" and
# "due today" mean on the dashboard. Defaults to UTC when unset.
SHOP_TIME_ZONE="UTC"

# --- AI Operations Brief (optional) -----------------------------------------
# Google Gemini API key from https://aistudio.google.com/apikey. Server-side
# only: never prefix with NEXT_PUBLIC_. Leave empty to use the rule-based brief.
GEMINI_API_KEY=""

# Optional model override. Defaults to "gemini-flash-latest".
GEMINI_MODEL=""

# --- Authentication (required for sign-in) ----------------------------------
# Signs session cookies. At least 32 random characters: `npm run auth:secret`.
# Changing it signs everyone out.
AUTH_SECRET=""

# Editor account (can create and edit orders). Store only the scrypt hash from
# `npm run auth:hash-password`, never the password itself. Leave both empty to
# disable editing entirely.
EDITOR_USERNAME=""
EDITOR_PASSWORD_HASH=""

# "false" hides the read-only demo button on the sign-in page. Default: enabled.
DEMO_VIEWER_ENABLED="true"
